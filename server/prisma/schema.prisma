datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  LINKEDIN
  COLD_CALL
  EMAIL_CAMPAIGN
  EVENT
  OTHER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  leads        Lead[]
}

model Lead {
  id        String     @id @default(uuid())
  name      String
  email     String
  phone     String
  company   String
  source    LeadSource
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
  @@unique([userId, email])
}
